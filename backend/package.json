{
  "name": "dhanseva-backend",
  "version": "1.0.0",
  "description": "Legal Services Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && npm run copy-templates",
    "copy-templates": "node -e \"require('fs').cpSync('src/templates', 'dist/templates', {recursive: true})\"",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:api": "tsx src/tests/runTests.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "legal",
    "services",
    "platform"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.6",
    "redis": "^4.7.1",
    "uploadthing": "^6.3.3",
    "zod": "^3.25.76",
    "@types/node": "^20.19.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0"
  }
}
